trellis-aeneas-cross-verifier-pilot> -{"charon_version":"0.1.223","translated":{"crate_name":"verified_logic","options":{"ullbc":false,"precise_drops":false,"skip_borrowck":false,"mir":null,"rustc_args":[],"targets":[],"sysroot":null,"monomorphize":false,"monomorphize_mut":null,"start_from":["crate::arithmetic::abs_diff"],"start_from_if_exists":[],"start_from_attribute":[],"start_from_pub":false,"include":[],"opaque":[],"exclude":[],"extract_opaque_bodies":false,"translate_all_methods":false,"duplicate_defaulted_methods":false,"lift_associated_types":["*"],"hide_marker_traits":true,"hide_allocator":true,"remove_unused_clauses":false,"remove_unused_self_clauses":true,"remove_adt_clauses":true,"desugar_drops":false,"ops_to_function_calls":true,"index_to_function_calls":true,"treat_box_as_builtin":true,"raw_consts":false,"consts":null,"unsized_strings":false,"reconstruct_fallible_operations":true,"reconstruct_asserts":true,"unbind_item_vars":true,"print_original_ullbc":false,"print_ullbc":false,"print_built_llbc":false,"print_llbc":false,"dest_dir":null,"dest_file":"llbc.llbc","no_dedup_serialized_ast":false,"format":null,"no_serialize":false,"no_typecheck":false,"no_normalize":false,"no_reorder_decls":false,"abort_on_error":false,"error_on_warnings":false,"preset":"Aeneas"},"target_information":[{"key":"x86_64-unknown-linux-gnu","value":{"target_pointer_size":8,"is_little_endian":true}}],"files":[{"id":0,"name":{"Local":"src/arithmetic.rs"},"crate_name":"verified_logic","contents":"//! Verified arithmetic operations.\n//!\n//! Each function has a `spec fn` (mathematical definition) and an `exec fn`\n//! whose `ensures` clause ties it to the spec. Verus mechanically checks\n//! that the implementation matches — drift is impossible.\n\nuse vstd::prelude::*;\n\nverus! {\n\n// --- abs_diff ---\n\n// r[depends arithmetic.abs-diff]\n/// Spec: absolute difference of two u64 values.\npub open spec fn abs_diff_spec(a: u64, b: u64) -> u64 {\n    if a >= b { (a - b) as u64 } else { (b - a) as u64 }\n}\n\n// r[impl arithmetic.abs-diff]\n/// Returns the absolute difference between two `u64` values.\npub fn abs_diff(a: u64, b: u64) -> (result: u64)\n    ensures result == abs_diff_spec(a, b)\n{\n    if a >= b { a - b } else { b - a }\n}\n\n// r[verify arithmetic.abs-diff]\nproof fn abs_diff_symmetric(a: u64, b: u64)\n    ensures abs_diff_spec(a, b) == abs_diff_spec(b, a)\n{}\n\n// r[verify arithmetic.abs-diff]\nproof fn abs_diff_self_is_zero(x: u64)\n    ensures abs_diff_spec(x, x) == 0u64\n{}\n\n// --- saturating_add ---\n\n// r[depends arithmetic.saturating-add]\n/// Spec: saturating addition.\npub open spec fn saturating_add_spec(a: u64, b: u64) -> u64 {\n    if a as int + b as int > u64::MAX as int {\n        u64::MAX\n    } else {\n        (a + b) as u64\n    }\n}\n\n// r[impl arithmetic.saturating-add]\n/// Saturating addition: returns `a + b` clamped to `u64::MAX`.\npub fn saturating_add(a: u64, b: u64) -> (result: u64)\n    ensures result == saturating_add_spec(a, b)\n{\n    match a.checked_add(b) {\n        Some(sum) => sum,\n        None => u64::MAX,\n    }\n}\n\n// r[verify arithmetic.saturating-add]\nproof fn saturating_add_bounded(a: u64, b: u64)\n    ensures saturating_add_spec(a, b) <= u64::MAX\n{}\n\n// r[verify arithmetic.saturating-add]\nproof fn saturating_add_commutative(a: u64, b: u64)\n    ensures saturating_add_spec(a, b) == saturating_add_spec(b, a)\n{}\n\n// --- saturating_sub ---\n\n// r[depends arithmetic.saturating-sub]\n/// Spec: saturating subtraction.\npub open spec fn saturating_sub_spec(a: u64, b: u64) -> u64 {\n    if b > a { 0 } else { (a - b) as u64 }\n}\n\n// r[impl arithmetic.saturating-sub]\n/// Saturating subtraction: returns `a - b` clamped to `0`.\npub fn saturating_sub(a: u64, b: u64) -> (result: u64)\n    ensures result == saturating_sub_spec(a, b)\n{\n    if b > a { 0 } else { a - b }\n}\n\n// r[verify arithmetic.saturating-sub]\nproof fn saturating_sub_exact(a: u64, b: u64)\n    requires a >= b\n    ensures saturating_sub_spec(a, b) == (a - b) as u64\n{}\n\n// --- checked_mul ---\n\n// r[depends arithmetic.checked-mul]\n/// Spec: checked multiplication.\npub open spec fn checked_mul_spec(a: u64, b: u64) -> Option<u64> {\n    if a as int * b as int > u64::MAX as int {\n        None\n    } else {\n        Some((a * b) as u64)\n    }\n}\n\n// r[impl arithmetic.checked-mul]\n/// Checked multiplication: returns `None` on overflow.\npub fn checked_mul(a: u64, b: u64) -> (result: Option<u64>)\n    ensures result == checked_mul_spec(a, b)\n{\n    a.checked_mul(b)\n}\n\n// r[verify arithmetic.checked-mul]\nproof fn checked_mul_zero(a: u64)\n    ensures\n        checked_mul_spec(a, 0) == Some(0u64),\n        checked_mul_spec(0, a) == Some(0u64),\n{}\n\n// --- gcd ---\n\n// r[depends arithmetic.gcd]\n/// Spec: greatest common divisor via Euclidean algorithm.\npub open spec fn gcd_spec(a: u64, b: u64) -> u64\n    decreases b\n{\n    if b == 0 { a } else { gcd_spec(b, (a % b) as u64) }\n}\n\n// r[impl arithmetic.gcd]\n/// Computes the greatest common divisor of `a` and `b`.\n///\n/// Uses the Euclidean algorithm. Terminates because `b` strictly\n/// decreases each iteration (`a % b < b`).\npub fn gcd(a: u64, b: u64) -> (result: u64)\n    ensures result == gcd_spec(a, b)\n    decreases b\n{\n    if b == 0 { a } else { gcd(b, a % b) }\n}\n\n// r[verify arithmetic.gcd]\n/// Proof: gcd(a, 0) == a.\nproof fn gcd_zero_left(a: u64)\n    ensures gcd_spec(a, 0) == a\n{}\n\n// r[verify arithmetic.gcd]\n/// Proof: gcd(0, a) == a.\nproof fn gcd_zero_right(a: u64)\n    ensures gcd_spec(0, a) == a\n    decreases a\n{\n    if a != 0 {\n        assert(0u64 % a == 0u64);\n        gcd_zero_left(a);\n    }\n}\n\n// --- div_ceil ---\n\n// r[depends arithmetic.div-ceil]\n/// Spec: ceiling division.\npub open spec fn div_ceil_spec(a: u64, b: u64) -> u64\n    recommends b > 0\n{\n    if a == 0 { 0 } else { (((a - 1) as int / b as int) + 1) as u64 }\n}\n\n// r[impl arithmetic.div-ceil]\n/// Ceiling division: returns the smallest integer >= a/b.\n///\n/// Uses `(a - 1) / b + 1` to avoid overflow from `(a + b - 1) / b`.\npub fn div_ceil(a: u64, b: u64) -> (result: u64)\n    requires b > 0\n    ensures result == div_ceil_spec(a, b)\n{\n    if a == 0 { 0 } else { (a - 1) / b + 1 }\n}\n\n// r[verify arithmetic.div-ceil]\n/// Proof: div_ceil(0, b) == 0 for all nonzero b.\nproof fn div_ceil_zero()\n    ensures forall|b: u64| b > 0 ==> div_ceil_spec(0, b) == 0u64\n{}\n\n} // verus!\n\n#[cfg(test)]\nmod tests {\n    use proptest::prelude::*;\n\n    use super::*;\n\n    // r[verify arithmetic.abs-diff]\n    #[test]\n    fn test_abs_diff() {\n        assert_eq!(abs_diff(10, 3), 7);\n        assert_eq!(abs_diff(3, 10), 7);\n        assert_eq!(abs_diff(5, 5), 0);\n        assert_eq!(abs_diff(0, u64::MAX), u64::MAX);\n    }\n\n    // r[verify arithmetic.saturating-add]\n    #[test]\n    fn test_saturating_add() {\n        assert_eq!(saturating_add(1, 2), 3);\n        assert_eq!(saturating_add(u64::MAX, 1), u64::MAX);\n        assert_eq!(saturating_add(0, 0), 0);\n    }\n\n    // r[verify arithmetic.saturating-sub]\n    #[test]\n    fn test_saturating_sub() {\n        assert_eq!(saturating_sub(10, 3), 7);\n        assert_eq!(saturating_sub(3, 10), 0);\n        assert_eq!(saturating_sub(0, u64::MAX), 0);\n    }\n\n    // r[verify arithmetic.checked-mul]\n    #[test]\n    fn test_checked_mul() {\n        assert_eq!(checked_mul(3, 4), Some(12));\n        assert_eq!(checked_mul(u64::MAX, 2), None);\n        assert_eq!(checked_mul(0, u64::MAX), Some(0));\n    }\n\n    proptest! {\n        // r[verify arithmetic.abs-diff]\n        #[test]\n        fn prop_abs_diff_symmetric(a: u64, b: u64) {\n            prop_assert_eq!(abs_diff(a, b), abs_diff(b, a));\n        }\n\n        // r[verify arithmetic.saturating-add]\n        #[test]\n        fn prop_saturating_add_commutative(a: u64, b: u64) {\n            prop_assert_eq!(saturating_add(a, b), saturating_add(b, a));\n        }\n\n        // r[verify arithmetic.saturating-sub]\n        #[test]\n        fn prop_saturating_sub_self_is_zero(a: u64) {\n            prop_assert_eq!(saturating_sub(a, a), 0);\n        }\n\n        // r[verify arithmetic.checked-mul]\n        #[test]\n        fn prop_checked_mul_zero(a: u64) {\n            prop_assert_eq!(checked_mul(a, 0), Some(0));\n            prop_assert_eq!(checked_mul(0, a), Some(0));\n        }\n\n        // r[verify arithmetic.gcd]\n        #[test]\n        fn prop_gcd_commutative(a: u64, b: u64) {\n            // GCD is commutative — verify empirically\n            prop_assert_eq!(gcd(a, b), gcd(b, a));\n        }\n\n        // r[verify arithmetic.gcd]\n        #[test]\n        fn prop_gcd_divides(a in 1u64..=1_000_000, b in 1u64..=1_000_000) {\n            let g = gcd(a, b);\n            if g > 0 {\n                prop_assert_eq!(a % g, 0);\n                prop_assert_eq!(b % g, 0);\n            }\n        }\n\n        // r[verify arithmetic.div-ceil]\n        #[test]\n        fn prop_div_ceil_ge_floor(a: u64, b in 1u64..=u64::MAX) {\n            prop_assert!(div_ceil(a, b) >= a / b);\n        }\n\n        // r[verify arithmetic.div-ceil]\n        #[test]\n        fn prop_div_ceil_exact_when_divisible(\n            b in 1u64..=1_000_000,\n            factor in 0u64..=1_000_000,\n        ) {\n            let a = b.saturating_mul(factor);\n            if a / b == factor {\n                // a is exactly divisible by b\n                prop_assert_eq!(div_ceil(a, b), factor);\n            }\n        }\n    }\n\n    // r[verify arithmetic.gcd]\n    #[test]\n    fn test_gcd() {\n        assert_eq!(gcd(12, 8), 4);\n        assert_eq!(gcd(8, 12), 4);\n        assert_eq!(gcd(7, 0), 7);\n        assert_eq!(gcd(0, 7), 7);\n        assert_eq!(gcd(0, 0), 0);\n        assert_eq!(gcd(17, 13), 1);\n        assert_eq!(gcd(100, 75), 25);\n    }\n\n    // r[verify arithmetic.div-ceil]\n    #[test]\n    fn test_div_ceil() {\n        assert_eq!(div_ceil(0, 3), 0);\n        assert_eq!(div_ceil(1, 3), 1);\n        assert_eq!(div_ceil(3, 3), 1);\n        assert_eq!(div_ceil(4, 3), 2);\n        assert_eq!(div_ceil(6, 3), 2);\n        assert_eq!(div_ceil(7, 3), 3);\n        assert_eq!(div_ceil(u64::MAX, 1), u64::MAX);\n    }\n}\n"},{"id":1,"name":{"Local":"src/lib.rs"},"crate_name":"verified_logic","contents":"//! Trellis: composable verified-logic building blocks.\n//!\n//! Every public function in this crate has machine-checked pre/postconditions\n//! verified by [Verus](https://verus-lang.github.io/verus/guide/). Requirements\n//! are tracked by [Tracey](https://tracey.bearcove.eu/) in `docs/requirements.md`.\n//!\n//! The `verus!` blocks are embedded directly in the source — Verus verifies\n//! the actual implementations, not separate spec files. For normal `cargo build`,\n//! the `vstd` crate erases all ghost code (specs, proofs, requires, ensures).\n//!\n//! ## Modules\n//!\n//! - `access_mode` — access mode partial order: read/write/delete/full with no-escalation\n//! - `append_entries_build` — Raft leader-side AppendEntries construction: prev_log, entries,\n//!   batching\n//! - `append_entries_check` — Raft AppendEntries consistency: prevLogIndex/prevLogTerm validation\n//! - `acid` — ACID transaction proofs: atomicity, consistency, isolation, durability\n//! - `arithmetic` — abs diff, saturating ops, checked mul\n//! - `backoff` — exponential backoff with cap and jitter bounds\n//! - `balance` — credit/debit with overflow protection and conservation proofs\n//! - `ballot` — vote tracking for Raft elections with quorum intersection safety\n//! - `barrier` — thread barrier: arrive, release on Nth arrival, generation counter\n//! - `beam_link` — BEAM bidirectional links and exit-signal propagation\n//! - `beam_mailbox` — BEAM FIFO mailboxes with selective receive and save-offset cursor\n//! - `beam_monitor` — BEAM monitors, DOWN delivery, demonitor flush\n//! - `beam_process` — BEAM process lifecycle and heap-isolation model\n//! - `beam_registry` — BEAM name registry with bijective name↔pid mapping\n//! - `beam_scheduler` — BEAM reduction-budget preemption and priority queue selection\n//! - `beam_send` — BEAM asynchronous send: append-if-live, drop-if-dead\n//! - `bitwise` — power-of-two, bit get/set/clear/toggle\n//! - `batch` — write batch limit checking and flush decisions\n//! - `bitfield` — multi-bit field extraction and insertion with round-trip proofs\n//! - `btree_balance` — B-tree node balance: fill factor, split/merge triggers, redistribution\n//! - `bitmap` — verified fixed-size bit set using bitwise ops\n//! - `bloom` — Bloom filter with no-false-negatives proof\n//! - `authorize` — three-factor authorization: subsumption × scope × mode\n//! - `approval` — merge gating: approval counting, stale detection, CI checks\n//! - `bounded_mpmc` — bounded MPMC queue: head/tail occupancy, enqueue/dequeue, slot generation,\n//!   capacity conservation\n//! - `bounded_peers` — bounded peer collection: capacity cap, self-exclusion, order preservation\n//! - `bounded_range` — ranges with optional upper bound (None = unbounded)\n//! - `buddy` — buddy system: block sizes, buddy addresses, coalescing, parent blocks\n//! - `causal_order` — causal delivery and consistent snapshots\n//! - `consistent_snapshot` — consistent cuts with lattice operations (join/meet) and message\n//!   consistency\n//! - `containment` — delegation containment: scope + mode + subsumption\n//! - `ability_effect` — finite ability requirement admission, handler discharge, and sandbox\n//!   attenuation\n//! - `algebraic_effect` — finite algebraic-effect signatures, handler coverage, residual calls, and\n//!   single-use continuation tokens\n//! - `typed_durable_reference` — finite typed durable reference, unpersist, and migration admission\n//! - `remote_computation` — finite remote computation dependency, ability, and resource admission\n//! - `semantic_refactoring` — finite immutable name movement, compatible propagation, and\n//!   unresolved-dependent admission\n//! - `content_addressed_code` — finite content-addressed definition identity, dependency closure,\n//!   and recursive group admission\n//! - `consistent_hash` — consistent hash ring with complete coverage\n//! - `consistency_history` — shared operation vocabulary for consistency-model predicates\n//! - `consistency_object` — object-level sequential-consistency and linearizability predicates\n//! - `consistency_refinement` — implication edges and availability-envelope metadata for\n//!   consistency models\n//! - `consistency_relations` — shared real-time, session, visibility, arbitration, and conflict\n//!   relations\n//! - `consistency_session` — session guarantees and causal-consistency predicates\n//! - `consistency_transactional` — abstract transactional consistency predicates and refinement\n//!   skeletons\n//! - `crdt` — G-Counter, PN-Counter, LWW-Register with merge laws\n//! - `cryptoshedding` — key-tree recoverability, shedding, subtree effects, rotation\n//! - `bounds` — range predicates, clamping\n//! - `cas` — compare-and-swap condition evaluation\n//! - `cas_loop` — CAS retry loop modeling: success/failure, ABA detection via generation counters,\n//!   retry bounds\n//! - `chain` — chain hash integrity with append-preserves proof\n//! - `choreography_global` — finite global choreography syntax, participants, and well-formedness\n//! - `choreography_ownership` — normalized finite value ownership and atomic owner transfer\n//! - `choreography_local` — finite local choreography syntax, branch lookup, and merge\n//! - `choreography_projection` — projectability checks and endpoint projection\n//! - `choreography_step` — one-step global/local reduction and projection alignment helpers\n//! - `check_quorum` — leader liveness: step down when quorum contact lost\n//! - `circuit_breaker` — three-state circuit breaker: closed/open/half-open\n//! - `chunk` — ceiling-division chunk arithmetic, offset↔chunk mapping\n//! - `client_routing` — Raft client request routing: accept/redirect/reject by node role\n//! - `client_session` — Raft client session deduplication for exactly-once semantics (§8)\n//! - `config_change` — Raft configuration change protocol FSM: stable↔joint transitions (§6)\n//! - `collections` — sorted insert, binary search\n//! - `commit_advance` — Raft commit index advancement with §5.4.2 current-term guard\n//! - `commit_notify` — commit notification dispatch: newly committed ranges, proposal status\n//! - `compaction_fence` — log compaction coordination with replication: safe compact index\n//! - `constant_time_eq` — fixed-iteration XOR-fold comparison for 32-byte hashes\n//! - `control_flow_graph` — basic block partitioning, leader identification, CFG edges, and\n//!   dead-block detection\n//! - `dominator_tree` — iterative dominator sets, immediate dominators, and dominance frontiers\n//! - `loop_detection` — back-edge classification, loop bodies over reachability/dominator views,\n//!   exit edges, and nesting\n//! - `liveness_analysis` — backward live-in/live-out dataflow, fixed-point checking, and live-range\n//!   projection\n//! - `hir_attribute_parsing` — finite inert parser descriptors, policy admission, deterministic\n//!   reasons, and early/late metadata agreement\n//! - `rustc_metadata_identity` — finite crate-artifact identity, encoded-MIR, usage-mode, and\n//!   bounded dependency-selection admission\n//! - `register_allocation` — live-range overlap graphs, conflict-free register assignment, and\n//!   deterministic spill fallback\n//! - `stack_frame_layout` — aligned stack-slot placement, exact rounded frame sizing, and explicit\n//!   safe-reuse checks over live ranges\n//! - `track_caller_abi` — finite caller-location metadata, direct-call propagation, trait\n//!   inheritance, reify-shim, and const/codegen trace admission\n//! - `wasm_primitives` — exact Wasm value tags, `i32.add` stack discipline, typed local access,\n//!   l